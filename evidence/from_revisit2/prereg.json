 "arms": {
  "S": "strong baseline: same Nemotron lane via Nightshift, policy + item facts + the package's 20 most recent raw tracker decision events before the time wall; no Meterless (../revisit/triage_agent.py run_S, unchanged)",
  "OURS": "always use memory: Planner reads H-MEM (current stances, supersession, relevance recall, stance changes) -> Executor -> Evaluator (../revisit/triage_agent.py run_OURS, unchanged)",
  "GATED": "memory gatekeeper: for each item a frozen gate function (H-MEM features + the two arms' proposals; never the answer) chooses the OURS answer (trust memory) or the S answer (path without memory). Gate code is written only from s300 clean results + dev60, and its SHA-256 is committed BEFORE the first fresh300 model call. GATED reuses the fresh300 S and OURS runs; its cost per item = S + OURS calls.",
  "NN": "time-walled TF-IDF nearest neighbour inside the package (../revisit/eval_gates.py base_preds), no model"
 },
 "run_rules": {
  "nightshift": "all model calls only through Nightshift; header meterless-scope = iso-<uuid4> per request; at most 1 request in flight; HTTP 404/502 and timeouts retried with backoff",
  "model": "nvidia/nemotron-3-super-120b-a12b requested (same lane as s300); served model logged per call",
  "replay": "chronological, wall by wall; H-MEM only holds snapshots up to the item's wall",
  "complete": "all three gates need all 300 items predicted by S and OURS (n_common = 300); otherwise every gate fails. Unparsed replies count as the parser default (NEXT), as on s300."
 },
 "metric": {
  "main": "macro-F1 over URGENT, NEXT, WONTFIX, NOTAFF",
  "bootstrap": "paired bootstrap, 2,000 resamples of the 300 items, random.Random(11), 95% interval = sorted[50], sorted[1949] (../revisit/eval_gates.py boot)"
 },
 "gates": {
  "G1": "GATED - S macro-F1 difference: lower 95% bound > 0",
  "G2": "GATED - OURS macro-F1 difference: lower 95% bound >= 0",
  "G3": "GATED - NN macro-F1 difference: lower 95% bound > 0",
  "submit_rule": "topic 3 is submitted only if G1, G2, G3 and the reopen gate all pass. Thresholds are not changed after this file is sealed.",
  "side_metrics_reported_not_deciding": [
   "URGENT F1",
   "WONTFIX F1",
   "model calls and tokens per item"
  ]
 },
 "reopen": {
  "set": "volume B: all 286 conditional bookworm deferrals (../revisit/data/volB.json; \"revisit when fixed upstream\" etc.)",
  "eval_date": "Debian tracker list.txt of 2026-10-23 (now); upstream data fetched 2026-10-23/24",
  "truth": {
   "rule": "condition met by the eval date, decided automatically from objective records only (no AI, no human labels)",
   "generic": "met if ANY of: (a) Debian tracker now: the unstable (sid) line of this (CVE, pkg) is a fixed version; (b) a GitHub fix commit linked in the tracker NOTE of this CVE is contained in at least one upstream release tag of that repository; (c) OSV.dev record of the CVE or its aliases lists a \"fixed\" version in an ECOSYSTEM/SEMVER range of a non-distribution ecosystem (Debian, Ubuntu, Alpine, Red Hat, SUSE, AlmaLinux, Rocky, Mageia, openEuler, Chainguard, Wolfi and other distros excluded; GIT ranges excluded).",
   "branch": "conditions naming a branch (\"fixed in the 5.1 branch\", \"fixed in 5.1.x\"): met only if the fix is on that upstream branch in a release tag (../revisit/data/ffmpeg51.json, git release/5.1); (a) and (c) do not count",
   "dates": "condition date = earliest of: tracker git commit that first shows the sid fixed version; earliest release tag date containing the fix (reported, not gating)",
   "unknown": "no objective source says fixed -> not met (primary). Sensitivity reported: items with no source other than (a) excluded."
  },
  "arms": {
   "R0": "copy the trigger: unstable fixed at any monthly snapshot or now",
   "R1": "LTS script from_next_lts: trixie DSA, or a trixie fixed line",
   "R2": "plain table (cve, pkg, condition text as recorded at deferral, deferred_at) + the same Nemotron via Nightshift reads the same evidence bundle as OURS and answers met / not met; no Meterless",
   "OURS": "Revisit watcher: Nemotron compiles each distinct condition text into a query template once; waits and condition events live in the World Model, H-MEM holds the current condition per wait (supersession) and a re-review memory per fired event; the daily watcher runs the templates over the evidence bundle. Code SHA-256 committed before the truth file is computed."
  },
  "evidence_bundle": "identical for R2 and OURS: tracker now lines (sid, trixie, bookworm) for the pair; for every URL in the CVE NOTE: GitHub issue/PR state, merged_at, closed reason; GitHub commit existence and the release tags containing it; other pages: title + status keywords. OSV is NOT in the bundle (independent truth source).",
  "metric": "F1 of the reopen flag against truth on all 286; paired bootstrap 2,000, random.Random(11)",
  "gate": "OURS - R2 F1 difference: lower 95% bound > 0. R0 and R1 reported."
 },
